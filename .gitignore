.env
infra/.env
.venv/
.venv.libressl-bak/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Dataset splits and lookups (large, regenerable — see scripts/prepare_*.py)
data/*.parquet
data/*.csv
!data/.gitkeep

# Small provenance/report JSON+MD files (split_metadata.json, query_metadata.json,
# data/reports/*) are intentionally tracked — they're the thesis's exact-stats deliverables.

# Cross-process run-state (benchmark_api/run_state.py): live status + log
# tailing for in-flight runs, keyed by run_id/step/system. Ephemeral —
# regenerated on every run, not a deliverable like data/reports/*.
data/.runs/

# repository-s3 plugin zip, fetched on the host and COPY'd into opensearch-s1.Dockerfile
# (see README "Search infrastructure") — large binary, regenerable via curl.
infra/s1/repository-s3-*.zip

# Formal-experiment outputs (scripts/formal/): canonical-baseline volume
# snapshots and the 18-run result bundles. Large/regenerable — not source.
results/
